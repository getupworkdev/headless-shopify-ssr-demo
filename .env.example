# Leave empty to use Shopify's public demo store (mock.shop).
SHOPIFY_STORE_DOMAIN=
# Public Storefront API token (Shopify admin > Headless / Storefront API). Not needed for mock.shop.
SHOPIFY_STOREFRONT_TOKEN=
# Optional absolute site URL for canonical links, sitemap and JSON-LD.
# Defaults to the origin of the incoming request.
SITE_URL=
